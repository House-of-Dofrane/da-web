# Copy to .env.local for local development. Set the same names in the Vercel project settings.

# Supabase project that owns public.inbound_submit (Finance Core). Both values are public by
# design: the URL and the publishable (client-safe) key. Never put a service-role key here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional. When set, each stored lead POSTs {event, dealId, zip, condition, occupancy, timeline}
# here. No seller name, phone, email or street address is sent.
LEAD_NOTIFY_WEBHOOK_URL=
